let lang=localStorage.getItem("syntix-lang")||"ru",cat="all",q="",sort="featured",favs=new Set(JSON.parse(localStorage.getItem("syntix-favs")||"[]"));
const $=s=>document.querySelector(s),$$=s=>[...document.querySelectorAll(s)],tr=k=>L[lang][k]||L.ru[k]||k;
function language(){document.documentElement.lang=lang;$$("[data-i]").forEach(e=>e.textContent=tr(e.dataset.i));$$("[data-i-html]").forEach(e=>e.innerHTML=tr(e.dataset.iHtml));$$("[data-i-placeholder]").forEach(e=>e.placeholder=tr(e.dataset.iPlaceholder));$("#language").textContent=lang==="ru"?"EN":"RU";render();renderComparison();paintCmp()}
function render(){let arr=T.filter(t=>(cat==="all"||(cat==="fav"?favs.has(t[0]):t[3]===cat))&&(!q||hit(t)));if(sort==="az")arr.sort((a,b)=>a[0].localeCompare(b[0]));else if(sort==="rating")arr.sort((a,b)=>((rt[slugOf(b[0])]||{}).score||0)-((rt[slugOf(a[0])]||{}).score||0)||a[0].localeCompare(b[0]));const grid=$("#grid");grid.innerHTML="";arr.forEach(t=>{const card=document.createElement("article");card.className="card";card.tabIndex=0;card.setAttribute("role","link");card.setAttribute("aria-label",(lang==="ru"?"Подробнее о сервисе ":"Details about ")+t[0]);card.innerHTML=`<div class="cardtop"><div class="icon ${t[2]}">${t[1]}</div><div class="cardbtns"><button class="cmpbtn ${cmp.has(t[0])?"on":""}" type="button" aria-pressed="${cmp.has(t[0])}" title="${tr("compareTool")}" aria-label="${tr("compareTool")}">⚖</button><button class="fav ${favs.has(t[0])?"saved":""}" aria-label="Toggle favorite">${favs.has(t[0])?"♥":"♡"}</button></div></div><div class="titleline"><h3></h3><span class="tag"></span></div><p class="desc"></p><div class="bottom"><span class="free">● ${tr("freeTag")}</span><span class="rt"></span><a class="toolurl" target="_blank" rel="noopener noreferrer"></a></div>`;card.querySelector("h3").textContent=t[0];card.querySelector(".tag").textContent=L[lang].categories[t[3]];card.querySelector(".desc").textContent=lang==="ru"?t[4]:t[5];card.querySelector(".toolurl").href=t[6];card.querySelector(".toolurl").textContent=tr("open");{const r=rt[slugOf(t[0])];if(r)card.querySelector(".rt").textContent="★ "+r.avg.toFixed(1)+" ("+r.n+")"}card.querySelector(".fav").addEventListener("click",e=>{e.stopPropagation();favs.has(t[0])?favs.delete(t[0]):favs.add(t[0]);localStorage.setItem("syntix-favs",JSON.stringify([...favs]));cloudFav(t,favs.has(t[0]));render()});card.querySelector(".cmpbtn").addEventListener("click",e=>{e.stopPropagation();toggleCmp(t)});const openDetail=()=>{location.href="./tool.html?id="+encodeURIComponent(t[0].toLowerCase().normalize("NFKD").replace(/[^a-z0-9]+/g,"-").replace(/^-|-$/g,""))};card.addEventListener("click",e=>{if(!e.target.closest("a,button"))openDetail()});card.addEventListener("keydown",e=>{if((e.key==="Enter"||e.key===" ")&&!e.target.closest("a,button")){e.preventDefault();openDetail()}});grid.append(card)});$("#count").textContent=T.length;$("#resultLabel").textContent=tr("allResult")+arr.length+" / "+T.length;$("#empty").hidden=arr.length>0;grid.hidden=!arr.length}
function renderComparison(){const body=$("#comparisonBody");if(!body)return;body.innerHTML="";T.forEach(t=>{const row=document.createElement("tr");row.innerHTML="<td><strong></strong></td><td></td><td><span class='status'></span></td><td></td><td><a target='_blank' rel='noopener noreferrer'></a></td>";row.children[0].querySelector("strong").textContent=t[0];row.children[1].textContent=lang==="ru"?t[7]:t[8];row.children[2].querySelector("span").textContent=tr("yes");row.children[3].textContent=lang==="ru"?t[9]:t[10];const a=row.children[4].querySelector("a");a.href=t[6];a.textContent=tr("open");body.append(row)})}
$("#language").addEventListener("click",()=>{lang=lang==="ru"?"en":"ru";localStorage.setItem("syntix-lang",lang);language()});$("#query").addEventListener("input",e=>{q=e.target.value;render()});$("#sort").addEventListener("change",e=>{sort=e.target.value;render()});$("#filters").querySelectorAll("[data-cat]").forEach(b=>b.addEventListener("click",()=>{cat=b.dataset.cat;$("#filters").querySelectorAll("button").forEach(x=>x.classList.toggle("active",x===b));render()}));$("#reset").addEventListener("click",()=>{cat="all";q="";sort="featured";$("#query").value="";$("#sort").value="featured";$("#filters").querySelectorAll("button").forEach(b=>b.classList.toggle("active",b.dataset.cat==="all"));render()});$("#year").textContent=new Date().getFullYear();
// ---- Firestore favorites sync (guests keep using localStorage) ----
let fdb=null,fuser=null;
const slugOf=n=>n.toLowerCase().normalize("NFKD").replace(/[^a-z0-9]+/g,"-").replace(/^-|-$/g,"");
const favCol=()=>fdb.collection("profiles").doc(fuser.uid).collection("favorites");
function cloudFav(t,on){if(!fuser)return;const id=slugOf(t[0]);(on?favCol().doc(id).set({slug:id,toolName:t[0],createdAt:firebase.firestore.FieldValue.serverTimestamp()}):favCol().doc(id).delete()).catch(e=>console.warn("favorites sync",e))}
async function syncFavs(){if(!fuser)return;try{const snap=await favCol().get(),cloud=new Set(snap.docs.map(d=>d.id)),key="syntix-favs-synced";if(localStorage.getItem(key)!==fuser.uid){for(const name of favs){const id=slugOf(name);if(!cloud.has(id)){await favCol().doc(id).set({slug:id,toolName:name,createdAt:firebase.firestore.FieldValue.serverTimestamp()});cloud.add(id)}}localStorage.setItem(key,fuser.uid)}favs=new Set(T.filter(t=>cloud.has(slugOf(t[0]))).map(t=>t[0]));localStorage.setItem("syntix-favs",JSON.stringify([...favs]));render()}catch(e){console.warn("favorites sync",e)}}
(function(){const c=window.SYNTIX_CONFIG?.firebase;if(!c||!c.apiKey||c.apiKey.startsWith("PASTE_")||!window.firebase||!firebase.firestore)return;if(!firebase.apps.length)firebase.initializeApp(c);fdb=firebase.firestore();firebase.auth().onAuthStateChanged(u=>{fuser=u;syncFavs()})})();


// ---- Ratings on cards + tool finder ----
let rt={};
if(window.SyntixRatings)SyntixRatings.get().then(r=>{rt=r;render()}).catch(e=>console.warn("ratings",e));
