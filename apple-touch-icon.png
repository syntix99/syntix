{id:"video",ic:"🎬",ru:"Видео и озвучка",en:"Video & voice",cats:["video"],kw:/video|видео|voice|озвуч|audio|аудио/},
{id:"music",ic:"🎵",ru:"Музыка",en:"Music",cats:[],kw:/music|музык|song|песн/},
{id:"code",ic:"💻",ru:"Программировать",en:"Code",cats:["code"],kw:/code|код|develop|разработ|prototype|прототип/},
{id:"docs",ic:"📊",ru:"Презентации и документы",en:"Slides & docs",cats:["work"],kw:/presentation|презентац|document|документ|notes|заметк/},
{id:"study",ic:"📚",ru:"Учиться",en:"Study",cats:[],kw:/study|учёб|учеб|notebook|конспект/}];
let fSel=new Set(),fMode="fit",fRes=null;
function findTools(){const sel=TASKS.filter(x=>fSel.has(x.id));return T.map(t=>{const hay=t.slice(0,11).join(" ").toLowerCase();let s=0;const why=[];sel.forEach(x=>{let p=0;if(x.cats.includes(t[3]))p+=3;if(x.kw.test(hay))p+=2;if(p){s+=p;why.push(x)}});const r=rt[slugOf(t[0])];return{t,s,why,r,total:s+(fMode==="rated"&&r?r.score*1.2:0)}}).filter(x=>x.s>0).sort((a,b)=>b.total-a.total||a.t[0].localeCompare(b.t[0])).slice(0,4)}
function paintFinder(){const d=$("#finderDlg");if(!d)return;const chip=(on,attr,txt)=>'<button type="button" class="fchip'+(on?" on":"")+'" '+attr+'>'+txt+"</button>";
const res=fRes===null?"":(fRes.length?'<h4 class="fh">'+esc(tr("finderTop"))+'</h4><div class="fres">'+fRes.map(x=>'<div class="fitem"><div class="icon '+esc(x.t[2])+'">'+esc(x.t[1])+'</div><div class="fbody"><b>'+esc(x.t[0])+(x.r?' <span class="rt">★ '+x.r.avg.toFixed(1)+' ('+x.r.n+')</span>':"")+'</b><p>'+esc(lang==="ru"?x.t[4]:x.t[5])+'</p><div class="fwhy">'+x.why.map(w=>"<span>"+w.ic+" "+esc(lang==="ru"?w.ru:w.en)+"</span>").join("")+'</div></div><div class="fbtns"><a class="btn primary" href="./tool.html?id='+encodeURIComponent(slugOf(x.t[0]))+'">'+esc(tr("finderDetails"))+'</a><a class="btn ghost" href="'+esc(x.t[6])+'" target="_blank" rel="noopener noreferrer">'+esc(tr("open"))+"</a></div></div>").join("")+"</div>":'<p class="muted">'+esc(tr("finderNone"))+"</p>");
d.innerHTML='<div class="cmpbox"><div class="cmphead"><h3>'+esc(tr("finderTitle"))+'</h3><button type="button" class="btn ghost" data-fclose aria-label="Close">✕</button></div><h4 class="fh">'+esc(tr("finderQ1"))+'</h4><div class="fchips">'+TASKS.map(x=>chip(fSel.has(x.id),'data-task="'+x.id+'"',x.ic+" "+esc(lang==="ru"?x.ru:x.en))).join("")+'</div><h4 class="fh">'+esc(tr("finderQ2"))+'</h4><div class="fchips">'+chip(fMode==="fit",'data-fmode="fit"',esc(tr("finderFit")))+chip(fMode==="rated",'data-fmode="rated"',esc(tr("finderRated")))+'</div><div class="fgo"><button type="button" class="btn primary" data-fgo'+(fSel.size?"":" disabled")+">"+esc(tr("finderGo"))+"</button></div>"+res+"</div>"}
function openFinder(){let d=$("#finderDlg");if(!d){d=document.createElement("dialog");d.id="finderDlg";d.className="cmpdlg";document.body.append(d);d.addEventListener("click",e=>{if(e.target===d||e.target.closest("[data-fclose]")){d.close();return}const c=e.target.closest("[data-task]");if(c){fSel.has(c.dataset.task)?fSel.delete(c.dataset.task):fSel.add(c.dataset.task);fRes=null;paintFinder();return}const m=e.target.closest("[data-fmode]");if(m){fMode=m.dataset.fmode;fRes=null;paintFinder();return}if(e.target.closest("[data-fgo]")&&fSel.size){fRes=findTools();paintFinder()}})}fSel=new Set();fMode="fit";fRes=null;paintFinder();d.showModal()}
{const fb=$("#finderBtn");if(fb)fb.addEventListener("click",openFinder)}
// ---- Search matching, compare drawer ----
const esc=s=>String(s??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
function hit(t){const hay=(t.slice(0,11).join(" ")+" "+L.ru.categories[t[3]]+" "+L.en.categories[t[3]]).toLowerCase();return q.toLowerCase().split(/\s+/).filter(Boolean).every(w=>hay.includes(w))}
const cmp=new Set();
const cmpMax=()=>window.Premium&&Premium.meActive?6:3;
window.addEventListener("syntix-premium",()=>paintCmp());
function toggleCmp(t){if(cmp.has(t[0]))cmp.delete(t[0]);else{if(cmp.size>=cmpMax()){if(window.toast)toast(tr("cmpMax"));return}cmp.add(t[0])}render();paintCmp()}
function paintCmp(){let bar=$("#cmpbar");if(!bar){bar=document.createElement("div");bar.id="cmpbar";bar.className="cmpbar";bar.innerHTML='<span id="cmpinfo"></span><button type="button" class="btn primary" id="cmpopen"></button><button type="button" class="btn ghost" id="cmpclear"></button>';document.body.append(bar);$("#cmpopen").onclick=openCmp;$("#cmpclear").onclick=()=>{cmp.clear();render();paintCmp()}}bar.style.display=cmp.size?"flex":"none";$("#cmpinfo").textContent=cmp.size+" / "+cmpMax();$("#cmpopen").textContent=tr("cmpOpen");$("#cmpopen").disabled=cmp.size<2;$("#cmpclear").textContent=tr("cmpClear")}
function openCmp(){const rows=[...cmp].map(n=>T.find(t=>t[0]===n)).filter(Boolean);if(rows.length<2)return;let d=$("#cmpdlg");if(!d){d=document.createElement("dialog");d.id="cmpdlg";d.className="cmpdlg";document.body.append(d);d.addEventListener("click",e=>{if(e.target===d||e.target.closest("[data-close]"))d.close()})}const row=(label,f)=>"<tr><th>"+esc(label)+"</th>"+rows.map(t=>"<td>"+f(t)+"</td>").join("")+"</tr>";d.innerHTML='<div class="cmpbox"><div class="cmphead"><h3>'+esc(tr("compareTool"))+'</h3><button type="button" class="btn ghost" data-close aria-label="Close">✕</button></div><div class="tablewrap"><table class="comparison cmptable"><thead><tr><th></th>'+rows.map(t=>"<th>"+esc(t[0])+"</th>").join("")+"</tr></thead><tbody>"+row(tr("thCategory"),t=>esc(L[lang].categories[t[3]]))+row(tr("thUse"),t=>esc(lang==="ru"?t[7]:t[8]))+row(tr("thFree"),t=>esc(lang==="ru"?t[9]:t[10]))+row(tr("thLink"),t=>'<a href="'+esc(t[6])+'" target="_blank" rel="noopener noreferrer">'+esc(tr("open"))+'</a> · <a href="./tool.html?id='+encodeURIComponent(slugOf(t[0]))+'">'+esc(lang==="ru"?"Подробнее":"Details")+'</a>')+"</tbody></table></div></div>";d.showModal()}
document.addEventListener("keydown",e=>{if(e.key==="Escape"&&document.activeElement===$("#query")&&q){q="";$("#query").value="";render()}});
// ---- URL params (?cat=code&q=chat) and "/" to focus search ----
(function(){const P=new URLSearchParams(location.search),c=P.get("cat");if(c&&(c==="fav"||L.ru.categories[c]))cat=c;if(P.get("q")){q=P.get("q");$("#query").value=q}$("#filters").querySelectorAll("button").forEach(b=>b.classList.toggle("active",b.dataset.cat===cat));document.addEventListener("keydown",e=>{if(e.key==="/"&&!/INPUT|TEXTAREA|SELECT/.test(document.activeElement.tagName)){e.preventDefault();$("#query").focus()}})})();
language();
